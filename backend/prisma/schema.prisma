generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------------------------------------------------------
// User & Auth
// ---------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           String    @default("USER") // USER, DIETITIAN, DOCTOR, ADMIN, SUPER_ADMIN
  isVerified     Boolean   @default(false)
  otpSecret      String?
  refreshToken   String?
  googleId       String?
  appleId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        Profile?
  healthRecord   HealthRecord?
  doctorProfile  DoctorProfile?
  dietitianProfile DietitianProfile?

  mealLogs       MealLog[]
  waterLogs      WaterLog[]
  sleepLogs      SleepLog[]
  workoutLogs    WorkoutLog[]
  progressLogs   ProgressLog[]
  goals          Goal[]

  orders         Order[]
  reviews        Review[]
  cart           Cart?
  wishlist       Wishlist?

  appointmentsAsPatient Appointment[] @relation("PatientAppointments")

  reports        Report[]
  userChallenges UserChallenge[]
  userBadges     UserBadge[]
  userRewards    UserReward[]

  posts          Post[]
  comments       Comment[]
  likes          Like[]
  notifications  Notification[]
  chatMessagesSent     ChatMessage[] @relation("MessageSender")
  chatMessagesReceived ChatMessage[] @relation("MessageReceiver")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  phone       String?
  avatarUrl   String?
  dateOfBirth DateTime?
  gender      String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Professional Profiles
// ---------------------------------------------------------

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  licenseNumber   String
  yearsExperience Int
  consultationFee Float
  bio             String?
  appointments    Appointment[] @relation("DoctorAppointments")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DietitianProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications  String
  yearsExperience Int
  consultationFee Float
  bio             String?
  dietPlans       DietPlan[]
  appointments    Appointment[] @relation("DietitianAppointments")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------
// Health & Tracking
// ---------------------------------------------------------

model HealthRecord {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodType   String?
  heightCm    Float?
  weightKg    Float?
  allergies   String?  // JSON stringified array for SQLite
  conditions  String?  // JSON stringified array for SQLite
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DietPlan {
  id           String   @id @default(uuid())
  dietitianId  String
  dietitian    DietitianProfile @relation(fields: [dietitianId], references: [id])
  title        String
  description  String
  calories     Int
  durationDays Int
  meals        Meal[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Meal {
  id          String   @id @default(uuid())
  dietPlanId  String
  dietPlan    DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  name        String
  timeOfDay   String // e.g., Breakfast, Lunch, Dinner, Snack
  calories    Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  recipeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MealLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  calories    Int
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  imageUrl    String?
  loggedAt    DateTime @default(now())
}

model WaterLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl    Int
  loggedAt    DateTime @default(now())
}

model SleepLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMin Int
  quality     Int?     // 1-10
  loggedAt    DateTime @default(now())
}

model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  durationMin Int
  caloriesBurned Int?
  loggedAt    DateTime @default(now())
}

model ProgressLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg    Float?
  bodyFatPct  Float?
  frontPicUrl String?
  sidePicUrl  String?
  loggedAt    DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // e.g., WEIGHT_LOSS, MUSCLE_GAIN
  targetValue Float
  currentValue Float
  deadline    DateTime?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, ABANDONED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// E-commerce
// ---------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String
  price       Float
  stock       Int
  imageUrl    String?
  orderItems  OrderItem[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Float
  status      String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED
  items       OrderItem[]
  payment     Payment?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtBuy  Float
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String   // STRIPE, PAYPAL, RAZORPAY
  status      String   @default("PENDING")
  transactionId String?
  createdAt   DateTime @default(now())
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

model Cart {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)
}

model Wishlist {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WishlistItem[]
}

model WishlistItem {
  id          String   @id @default(uuid())
  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}

// ---------------------------------------------------------
// Healthcare & Telemedicine
// ---------------------------------------------------------

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  patient        User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId       String?
  doctor         DoctorProfile? @relation("DoctorAppointments", fields: [doctorId], references: [id])
  dietitianId    String?
  dietitian      DietitianProfile? @relation("DietitianAppointments", fields: [dietitianId], references: [id])
  scheduledAt    DateTime
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  meetingLink    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String   // BLOOD_TEST, XRAY, MRI, GENERAL
  fileUrl     String
  aiSummary   String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// Gamification & Rewards
// ---------------------------------------------------------

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String
  xpReward    Int
  startDate   DateTime
  endDate     DateTime
  participants UserChallenge[]
}

model UserChallenge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  @@unique([userId, challengeId])
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  iconUrl     String
  userBadges  UserBadge[]
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt   DateTime @default(now())
  @@unique([userId, badgeId])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String
  costCoins   Int
  userRewards UserReward[]
}

model UserReward {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime @default(now())
}

// ---------------------------------------------------------
// Social & Community
// ---------------------------------------------------------

model Post {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  imageUrl    String?
  comments    Comment[]
  likes       Like[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
}

model Like {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([userId, postId])
}

// ---------------------------------------------------------
// Chat & Notifications
// ---------------------------------------------------------

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
